rules_version = '2';

// كل مستخدم يقرأ ويكتب بياناته فقط: ملفه الصحي في users/{uid} ووجباته في users/{uid}/meals
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /meals/{mealId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
